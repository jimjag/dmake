# Build artifacts from the autotools build. Nothing here is tracked source;
# "make distclean" removes it all.

# Compiled output
*.o
*.obj
/dmake
/dmake.exe

# Generated by configure / autogen.sh. These are anchored on purpose: the
# per-platform config.h and config.mk files, and dbug/malloc/makefile, are
# tracked source with the same basenames.
/Makefile
/tests/Makefile
/startup/Makefile
/startup/*/Makefile
/startup/*/*/Makefile
/startup/config.mk
/config.h
/config.log
/config.status
/dmakeroot.h
/stamp-h1
/autom4te.cache/
.deps/
.dirstamp

# make check leaves these behind in tests/
tests/*.log
tests/*.trs
tests/*-OUTPUT/

.DS_Store
